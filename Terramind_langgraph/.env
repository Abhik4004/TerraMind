OLLAMA_HOST=http://localhost:11434

# MongoDB (auth + session/chat-history persistence). Leave empty to use
# the local JSON/in-memory fallbacks.
MONGO_URI=mongodb+srv://ghoshabhik2004_db_user:XTL6UMLqWNhxDEwe@terramind.aad9ml6.mongodb.net/?appName=Terramind

# Model Configuration
LLM_MODEL=gpt-oss:120b-cloud
EMBEDDING_MODEL=nomic-embed-text:latest

# RAG Configuration
COLLECTION_NAME=terramind-rag-chroma
CHUNK_SIZE=50
MAX_CHARS=1500

# Retrieval Settings
RETRIEVAL_K=5
RELEVANCE_THRESHOLD=0.7

MAX_RETRIES=5
TOOL_TIMEOUT=30

# External APIs: Open-Meteo (weather + air quality) and Overpass/OSM (roads).
# Both are free, open-source and require NO API key.

# Geo-bounds — keep answers near the queried location
GEO_BOUNDS_ENABLED=true
GEO_BOUNDS_RADIUS_KM=75

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_STREAM_PER_MINUTE=20