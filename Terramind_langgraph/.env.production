# Production config for EC2 free-tier (t2/t3.micro, 1 GB RAM) — no Ollama.
# Copy to .env on the instance, or pass as --env-file to `docker run`.

# LLM: Groq (remote inference, fits 1 GB RAM)
LLM_PROVIDER=groq
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings: fastembed (small ONNX model, CPU, no torch, no server)
EMBED_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# MongoDB — rotate this password in Atlas before going live, then update here.
MONGO_URI=mongodb+srv://ghoshabhik2004_db_user:XTL6UMLqWNhxDEwe@terramind.aad9ml6.mongodb.net/?appName=Terramind

# RAG / retrieval
COLLECTION_NAME=terramind-rag-chroma
CHUNK_SIZE=50
MAX_CHARS=1500
RETRIEVAL_K=5
RELEVANCE_THRESHOLD=0.7
MAX_RETRIES=3
TOOL_TIMEOUT=30

GEO_BOUNDS_ENABLED=true
GEO_BOUNDS_RADIUS_KM=75

# Rate limiting (public instance — keep conservative on a micro box)
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_STREAM_PER_MINUTE=10

# Self-RAG grading is 2 extra LLM calls per query — Groq is fast/free so this
# can stay on, unlike the local-Ollama case. Turn off if you hit rate limits.
HALLUCINATION_CHECK_ENABLED=true
ANSWER_CHECK_ENABLED=true

# Memory management — small box, keep the ceiling low
MAX_SESSIONS=150
MAX_HISTORY_MESSAGES=30
LLM_HISTORY_MESSAGES=6
SESSION_TTL_HOURS=24
CACHE_SWEEP_INTERVAL_MIN=60

STATIC_DIR=/app/static
